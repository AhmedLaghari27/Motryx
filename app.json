{
  "expo": {
    "name": "Motryx",
    "slug": "motryx",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.yourname.motryx",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.yourname.motryx"
    },
    "plugins": [
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Motryx connects to your OBD-II adapter to read vehicle data."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Motryx uses your location to measure speed and performance runs."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "a8665345-efce-4191-96ae-ef801babece9"
      }
    },
    "owner": "ahmed_27"
  }
}
